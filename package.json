{
  "name": "@teqfw/dem-idb",
  "version": "2.3.1",
  "description": "IndexedDB persistence adapter for TeqFW Domain Entity Model.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teqfw/dem-idb.git"
  },
  "homepage": "https://github.com/teqfw/dem-idb#readme",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "skills/",
    "src/",
    "types.d.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types.d.ts"
    }
  },
  "types": "types.d.ts",
  "scripts": {
    "test": "node --test test/integration.test.mjs test/unit/*.test.mjs test/unit/Api/*.test.mjs test/unit/Type/CryptoKey/*.test.mjs",
    "test:browser": "node --test test/browser/Runtime.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "verify": "npm test && npm run test:browser"
  },
  "dependencies": {
    "@teqfw/dem": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@teqfw/di": "^2.12.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "ext": ".mjs",
            "path": "./src",
            "prefix": "TeqFw_Dem_IDb_"
          }
        ]
      }
    }
  }
}

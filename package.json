{
  "name": "@teqfw/dem-idb",
  "version": "0.2.0",
  "description": "IndexedDB persistence adapter for TeqFW Domain Entity Model.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "src/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "types.d.ts",
    "skills/"
  ],
  "scripts": {
    "test": "npm run check:esm && node --test test/integration.test.mjs test/unit/*.test.mjs test/unit/Api/*.test.mjs test/unit/Type/CryptoKey/*.test.mjs",
    "verify": "npm test && npm run test:browser",
    "typecheck": "tsc -p jsconfig.json",
    "test:browser": "node --test test/browser/Runtime.test.mjs",
    "check:esm": "teqfw-esm-validator src --profile base"
  },
  "dependencies": {
    "@teqfw/dem": "github:teqfw/dem"
  },
  "peerDependencies": {
    "@teqfw/di": "^2.11.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.20.5",
    "@flancer32/skill-teqfw-esm-validator": "^0.15.2"
  },
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teqfw/dem-idb.git"
  },
  "homepage": "https://github.com/teqfw/dem-idb#readme",
  "publishConfig": {
    "access": "public"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "TeqFw_Dem_IDb_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      }
    }
  }
}

{
  "compilerOptions": {
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "maxNodeModuleJsDepth": 0,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["node"]
  },
  "include": [
    "src",
    "test",
    "types.d.ts",
    "node_modules/@flancer32/**/*.mjs",
    "node_modules/@flancer32/**/types.d.ts",
    "node_modules/@teqfw/**/*.mjs",
    "node_modules/@teqfw/**/types.d.ts"
  ],
  "exclude": [
    "ctx",
    "node_modules/**/*.js"
  ]
}
